# SHIL Beta browser/public variables
# Add these in Vercel/Netlify Environment Variables.
# The Supabase anon/publishable key is intended for browser use; never put SERVICE_ROLE here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional API base if SHIL server endpoints are deployed separately.
VITE_SHIL_API_BASE=
VITE_API_BASE_URL=

# Production cloud security mode.
VITE_SHIL_CLOUD_SECURITY_MODE=production
